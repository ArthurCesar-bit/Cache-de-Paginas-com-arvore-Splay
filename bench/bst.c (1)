    /* TODO: implementar em etapa futura */
    return no;
}

/* ---------------------------------------------------------
 * Percurso em ordem (in-order)
 * --------------------------------------------------------- */
void emOrdem(No *no) {
    if (no == NULL) {
        return;
    }
    emOrdem(no->esq);
    printf("%d ", no->chave);
    emOrdem(no->dir);
}

/* ---------------------------------------------------------
 * Liberar memória
 * --------------------------------------------------------- */
void liberarArvore(No *no) {
    if (no == NULL) {
        return;
    }
    liberarArvore(no->esq);
    liberarArvore(no->dir);
    free(no);
}

/* ---------------------------------------------------------
 * Testes
 * --------------------------------------------------------- */
int main(void) {
    No *raiz = NULL;

    int valores[] = {50, 30, 70, 20, 40, 60, 80};
    int n = sizeof(valores) / sizeof(valores[0]);

    printf("Inserindo valores: ");
    for (int i = 0; i < n; i++) {
        printf("%d ", valores[i]);
        raiz = inserir(raiz, valores[i]);
    }
    printf("\n\n");

    printf("Percurso em ordem (deve sair crescente): ");
    emOrdem(raiz);
    printf("\n\n");

    /* ---- Testes de busca pelo pai (campo "raiz" do no) ---- */
    No *no20 = buscar(raiz, 20);
    No *no30 = buscar(raiz, 30);
    No *no50 = buscar(raiz, 50);

    printf("Teste 1: 20->raiz deve ser 30\n");
    if (no20 != NULL && no20->raiz != NULL) {
        printf("  Resultado: 20->raiz == %d  =>  %s\n",
               no20->raiz->chave,
               (no20->raiz->chave == 30) ? "OK" : "FALHOU");
    } else {
        printf("  Resultado: FALHOU (no nulo)\n");
    }

    printf("Teste 2: 30->raiz deve ser 50\n");
    if (no30 != NULL && no30->raiz != NULL) {
        printf("  Resultado: 30->raiz == %d  =>  %s\n",
               no30->raiz->chave,
               (no30->raiz->chave == 50) ? "OK" : "FALHOU");
    } else {
        printf("  Resultado: FALHOU (no nulo)\n");
    }

    printf("Teste 3: 50 e a raiz da arvore, logo 50->raiz deve ser NULL\n");
    if (no50 != NULL) {
        printf("  Resultado: 50->raiz == %s  =>  %s\n",
               (no50->raiz == NULL) ? "NULL" : "nao-NULL",
               (no50->raiz == NULL) ? "OK" : "FALHOU");
    }

    printf("\nLiberando memoria da arvore...\n");
    liberarArvore(raiz);
    raiz = NULL;
    printf("Memoria liberada com sucesso.\n");

    return 0;
}
