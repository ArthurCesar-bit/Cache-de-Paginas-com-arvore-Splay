/* ===========================================================
 * Etapa 2 — Adicionar ponteiro para a raiz (pai do no)
 * ===========================================================
 * O campo "raiz" dentro de No aponta para o PAI daquele no
 * especifico (nao confundir com a variavel externa "raiz",
 * que aponta para o topo da arvore inteira).
 *
 * Exemplo: se o no 30 e filho do no 50, entao:
 *     no30->raiz == no50
 * =========================================================== */

#include <stdio.h>
#include <stdlib.h>

typedef struct No {
    int chave;
    struct No *esq;
    struct No *dir;
    struct No *raiz;   /* ponteiro para o pai deste no */
} No;

/* ---------------------------------------------------------
 * Criar nó
 * --------------------------------------------------------- */
No *criarNo(int chave) {
    No *novo = (No *) malloc(sizeof(No));
    if (novo == NULL) {
        fprintf(stderr, "Erro: falha ao alocar memoria para o no.\n");
        exit(EXIT_FAILURE);
    }
    novo->chave = chave;
    novo->esq = NULL;
    novo->dir = NULL;
    novo->raiz = NULL; /* por padrao, sem pai (caso vire a raiz da arvore) */
    return novo;
}

/* ---------------------------------------------------------
 * Inserir
 * Insercao recursiva classica de BST (sem balanceamento).
 * "no" representa a raiz da subarvore atual (nao confundir
 * com o campo no->raiz, que e o ponteiro para o pai).
 * Ao inserir um filho, seu campo raiz e ajustado para apontar
 * para o no atual.
 * --------------------------------------------------------- */
No *inserir(No *no, int chave) {
    if (no == NULL) {
        return criarNo(chave);
    }

    if (chave < no->chave) {
        no->esq = inserir(no->esq, chave);
        no->esq->raiz = no;   /* atualiza o pai do filho esquerdo */
    } else if (chave > no->chave) {
        no->dir = inserir(no->dir, chave);
        no->dir->raiz = no;   /* atualiza o pai do filho direito */
    }
    /* chave == no->chave: nao insere duplicado */

    return no;
}

/* ---------------------------------------------------------
 * Buscar
 * Retorna o ponteiro para o no encontrado, ou NULL se nao existir.
 * Nao precisa de ajuste: apenas percorre a arvore, nao altera pais.
 * --------------------------------------------------------- */
No *buscar(No *no, int chave) {
    if (no == NULL || no->chave == chave) {
        return no;
    }

    if (chave < no->chave) {
        return buscar(no->esq, chave);
    } else {
        return buscar(no->dir, chave);
    }
}

