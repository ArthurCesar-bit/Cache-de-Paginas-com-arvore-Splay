int main(void) {
    /* ============================================================
     * TESTE 1 — Splay completo
     * (exemplo exato do enunciado)
     * Arvore antes:
     *         50
     *        /  \
     *      30    70
     *     /  \
     *    20  40
     * Buscar 20, depois splay(&raiz, no20).
     *
     * Analise do caminho de 20 at[e] a raiz:
     *   pai de 20 = 30, avo de 20 = 50.
     *   20 e filho esquerdo de 30, que e filho esquerdo de 50
     *   -> mesma direcao -> Zig-Zig esquerda-esquerda (uma unica
     *      iteracao do while resolve, pois 20 ja vira raiz).
     *
     * Esperado depois do splay:
     *      20
     *        \
     *         30
     *           \
     *            50
     *           /
     *          40
     *   (70 continua filho direito de 50, pois nao participa
     *    do caminho rotacionado)
     * ============================================================ */
    printf("=== TESTE 1: splay completo (exemplo do enunciado) ===\n");

    No *raiz1 = NULL;
    raiz1 = inserir(raiz1, 50);
    raiz1 = inserir(raiz1, 30);
    raiz1 = inserir(raiz1, 70);
    raiz1 = inserir(raiz1, 20);
    raiz1 = inserir(raiz1, 40);

    printf("Antes  (em ordem): ");
    emOrdem(raiz1);
    printf("  | raiz = %d\n", raiz1->chave);

    No *no20 = buscar(raiz1, 20);
    splay(&raiz1, no20);

    printf("Depois (em ordem): ");
    emOrdem(raiz1);
    printf("  | raiz = %d\n\n", raiz1->chave);

    No *no30 = buscar(raiz1, 30);
    No *no50 = buscar(raiz1, 50);
    No *no40 = buscar(raiz1, 40);
    No *no70 = buscar(raiz1, 70);

    printf("Verificacoes:\n");
    printf("  Nova raiz e 20?            %s (chave=%d)\n",
           (raiz1->chave == 20) ? "OK" : "FALHOU", raiz1->chave);
    printf("  raiz1 == no20?             %s\n",
           (raiz1 == no20) ? "OK" : "FALHOU");
    printf("  20->esq == NULL?           %s\n",
           (no20->esq == NULL) ? "OK" : "FALHOU");
    printf("  20->dir == 30?             %s\n",
           (no20->dir == no30) ? "OK" : "FALHOU");
    printf("  20->raiz == NULL (e raiz)? %s\n",
           (no20->raiz == NULL) ? "OK" : "FALHOU");
    printf("  30->raiz == 20?            %s\n",
           (no30->raiz == no20) ? "OK" : "FALHOU");
    printf("  30->esq == NULL?           %s\n",
           (no30->esq == NULL) ? "OK" : "FALHOU");
    printf("  30->dir == 50?             %s\n",
           (no30->dir == no50) ? "OK" : "FALHOU");
    printf("  50->raiz == 30?            %s\n",
           (no50->raiz == no30) ? "OK" : "FALHOU");
    printf("  50->esq == 40?             %s\n",
           (no50->esq == no40) ? "OK" : "FALHOU");
    printf("  50->dir == 70 (preservado)?%s\n",
           (no50->dir == no70) ? " OK" : " FALHOU");
    printf("  40->raiz == 50?            %s\n",
           (no40->raiz == no50) ? "OK" : "FALHOU");
    printf("  70->raiz == 50?            %s\n",
           (no70->raiz == no50) ? "OK" : "FALHOU");

    liberarArvore(raiz1);

    /* ============================================================
     * TESTE 2 — Splay com MULTIPLAS iteracoes do while
     * (caminho longo: precisa de Zig-Zig + Zig-Zag em sequencia,
     * nao resolve numa unica chamada de caso)
     * Arvore antes (insercoes na ordem 10,20,...,90 formam uma
     * "escada" so para a direita, depois buscamos 90 para
     * confirmar splay em arvore degenerada tambem funciona):
     *
     * Para testar caminho misto, construimos manualmente:
     *
     *              90
     *             /
     *            50
     *           /  \
     *          30   70
     *         /  \
     *        20   40
     *
     * x = 40: pai=30, avo=50. 40 e filho direito de 30, que e
     * filho esquerdo de 50 -> Zig-Zag (1a iteracao). Apos isso,
     * 40 fica filho direto da raiz (90) -> Zig (2a iteracao).
     * ============================================================ */
    printf("\n=== TESTE 2: splay com multiplas iteracoes (Zig-Zag + Zig) ===\n");

    No *raiz2 = NULL;
    raiz2 = inserir(raiz2, 90);
    raiz2 = inserir(raiz2, 50);
    raiz2 = inserir(raiz2, 30);
    raiz2 = inserir(raiz2, 70);
    raiz2 = inserir(raiz2, 20);
    raiz2 = inserir(raiz2, 40);

    printf("Antes  (em ordem): ");
    emOrdem(raiz2);
    printf("  | raiz = %d\n", raiz2->chave);

    No *no40b = buscar(raiz2, 40);
    splay(&raiz2, no40b);

    printf("Depois (em ordem): ");
    emOrdem(raiz2);
    printf("  | raiz = %d\n\n", raiz2->chave);

    printf("Verificacoes:\n");
    printf("  Nova raiz e 40?            %s (chave=%d)\n",
           (raiz2->chave == 40) ? "OK" : "FALHOU", raiz2->chave);
    printf("  40->raiz == NULL (e raiz)? %s\n",
           (no40b->raiz == NULL) ? "OK" : "FALHOU");
    printf("  Em ordem preservado (20,30,40,50,70,90)? ");
    {
        int esperado[] = {20, 30, 40, 50, 70, 90};
        int ok = 1;
        No *atual;
        int i = 0;
        /* percorre em ordem manualmente comparando com o vetor esperado */
        /* (reaproveita buscar para simplificar a checagem) */
        for (i = 0; i < 6; i++) {
            atual = buscar(raiz2, esperado[i]);
            if (atual == NULL || atual->chave != esperado[i]) {
                ok = 0;
                break;
            }
        }
        printf("%s\n", ok ? "OK" : "FALHOU");
    }

    liberarArvore(raiz2);

    return 0;
}
