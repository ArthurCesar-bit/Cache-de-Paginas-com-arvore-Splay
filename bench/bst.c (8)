 * Testes
 * --------------------------------------------------------- */
int main(void) {
    /* ============================================================
     * TESTE 1 — removerSplay, caso geral (ambas subarvores nao-vazias)
     * Arvore antes:
     *         50
     *        /  \
     *      30    70
     *     /  \
     *    20  40
     * removerSplay(50):
     *   1) splay(50) -> 50 ja e raiz, nada muda
     *   2) E = subarvore esquerda (30,20,40), D = subarvore
     *      direita (70); libera o no 50
     *   3) maior elemento de E e 40; splay(40) dentro de E faz
     *      40 subir (Zig simples), 30 descer para 40->esq
     *   4) D (70) e encaixado como 40->dir
     * Esperado depois:
     *        40
     *       /  \
     *      30    70
     *     /
     *    20
     * ============================================================ */
    printf("=== TESTE 1: removerSplay, caso geral ===\n");

    No *raiz1 = NULL;
    raiz1 = inserir(raiz1, 50);
    raiz1 = inserir(raiz1, 30);
    raiz1 = inserir(raiz1, 70);
    raiz1 = inserir(raiz1, 20);
    raiz1 = inserir(raiz1, 40);

    printf("Antes  (em ordem): ");
    emOrdem(raiz1);
    printf("  | raiz = %d\n", raiz1->chave);

    int ok1 = removerSplay(&raiz1, 50);

    printf("Depois (em ordem): ");
    emOrdem(raiz1);
    printf("  | raiz = %d\n\n", raiz1->chave);

    No *no40 = buscar(raiz1, 40);
    No *no30 = buscar(raiz1, 30);
    No *no70 = buscar(raiz1, 70);
    No *no20 = buscar(raiz1, 20);

    printf("Verificacoes:\n");
    printf("  removerSplay retornou 1?   %s\n",
           (ok1 == 1) ? "OK" : "FALHOU");
    printf("  50 nao existe mais?        %s\n",
           (buscar(raiz1, 50) == NULL) ? "OK" : "FALHOU");
    printf("  Nova raiz e 40?            %s (chave=%d)\n",
